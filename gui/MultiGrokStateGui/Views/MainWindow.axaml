<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MultiGrokStateGui.ViewModels"
        x:Class="MultiGrokStateGui.Views.MainWindow" x:DataType="vm:MainViewModel"
        Icon="/Assets/app-icon.ico" Title="MultiGrokState"
        Width="820" Height="540" MinWidth="520" MinHeight="360"
        Background="{DynamicResource CanvasBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <StyleInclude Source="/Views/ArchiveStyles.axaml" />
    </Window.Styles>
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,9" MaxWidth="1100">
                <Border Width="26" Height="26" CornerRadius="5" Background="{DynamicResource AccentTint}">
                    <Path Data="M 1,1 L 6,6 L 1,11 M 8,11 L 14,11" Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.6" Width="15" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="MultiGrokState" FontSize="16" FontWeight="SemiBold"
                           Margin="9,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Classes="flat" Content="Check updates" Command="{Binding CheckUpdateCommand}" />
                    <Button Content="Update" Command="{Binding UpdateCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="24,20,24,14" MaxWidth="1100">
            <TextBlock Text="Accounts" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" />
            <Border Grid.Column="1" Background="{DynamicResource TrackBrush}" CornerRadius="4"
                    Padding="7,2" Margin="8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Accounts.Count}" FontSize="12" ToolTip.Tip="Archived accounts" />
            </Border>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="Login" Command="{Binding LoginCommand}" IsVisible="{Binding !IsEmpty}" />
                <Button Content="Logout" Command="{Binding LogoutCommand}" />
                <Button Classes="primary" Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
        </Grid>

        <Panel Grid.Row="2" MaxWidth="1148">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Accounts}" Margin="24,0,24,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:AccountViewModel">
                            <Border Classes="account" Classes.active="{Binding IsActive}" Margin="0,0,0,9">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Identity}" ToolTip.Tip="{Binding Identity}" TextTrimming="CharacterEllipsis"
                                                       FontSize="17" FontWeight="SemiBold" />
                                            <WrapPanel>
                                                <TextBlock Classes="caption" Text="{Binding Name}" Margin="0,0,12,0" />
                                                <TextBlock Classes="caption" Text="{Binding Status, StringFormat='Token {0}'}" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <Panel Grid.Column="1" VerticalAlignment="Center">
                                            <Border IsVisible="{Binding IsActive}" CornerRadius="4" Padding="9,3"
                                                    Background="{DynamicResource AccentTint}">
                                                <TextBlock Text="Active" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                            <Button Content="Switch" CommandParameter="{Binding}" IsVisible="{Binding !IsActive}"
                                                    Command="{Binding $parent[Window].DataContext.SwitchCommand}"
                                                    IsEnabled="{Binding !$parent[Window].DataContext.IsBusy}" />
                                        </Panel>
                                    </Grid>

                                    <Grid IsVisible="{Binding HasUsage}" RowDefinitions="Auto,Auto"
                                          ColumnDefinitions="64,*,68,Auto" ColumnSpacing="8" RowSpacing="4">
                                        <TextBlock Classes="caption" Text="Weekly" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Classes="meter"
                                                     Value="{Binding PercentValue}" AutomationProperties.Name="Weekly usage" />
                                        <TextBlock Grid.Column="2" Classes="reading" Text="{Binding PercentText}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Classes="caption" Text="{Binding AllowanceText}" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Classes="caption" Text="Monthly" IsVisible="{Binding HasMonthly}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Classes="meter" IsVisible="{Binding HasMonthly}"
                                                     Value="{Binding MonthlyPercent, TargetNullValue=0}" AutomationProperties.Name="Monthly usage" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Classes="reading" Text="{Binding MonthlyPercentText}"
                                                   IsVisible="{Binding HasMonthly}" TextAlignment="Right" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Classes="caption" Text="{Binding MonthlyAllowanceText}"
                                                   IsVisible="{Binding HasMonthly}" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Classes="caption" Text="{Binding ResetText}" IsVisible="{Binding !!ResetText}" TextWrapping="Wrap" />
                                    <TextBlock Classes="caption" Text="{Binding UsageNote}" IsVisible="{Binding HasUsageNote}" TextWrapping="Wrap" />
                                    <TextBlock Classes="caption" Text="Fetching usage…" IsVisible="{Binding IsLoading}" />
                                    <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8" Margin="20">
                <TextBlock Text="No archived accounts" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Classes="caption" Text="Log in to Grok to save your first account." HorizontalAlignment="Center" />
                <Button Classes="primary" Content="Login" Command="{Binding LoginCommand}" HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>
        </Panel>

        <Border Grid.Row="3" Padding="24,8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Path Data="M 1,2 L 6,7 L 1,12 M 8,12 L 15,12" Stroke="{DynamicResource MutedBrush}"
                      StrokeThickness="1.5" Width="16" Height="14" VerticalAlignment="Center" />
                <ScrollViewer Grid.Column="1" MaxHeight="82" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Classes="caption" Text="{Binding StatusText}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
